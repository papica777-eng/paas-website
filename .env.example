# ═══════════════════════════════════════════════════════════════
# QANTUM PaaS — Environment Variables
# Copy to .env and fill in real values
# ═══════════════════════════════════════════════════════════════

PORT=3000
NODE_ENV=production

# Stripe (Live Mode)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Firebase Admin SDK
FIREBASE_PROJECT_ID=aeterna-sovereign
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@aeterna-sovereign.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXX\n-----END PRIVATE KEY-----\n"

# Sovereign Admin
SOVEREIGN_EMAIL=dp@qantum.site
